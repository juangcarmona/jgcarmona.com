---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');

	const paths = [];
	for (const post of posts) {
		// Original language route
		paths.push({
			params: { lang: post.data.lang, slug: post.id },
			props: post,
		});

		// Translation routes
		if (post.data.lang === 'es') {
			paths.push({
				params: { lang: 'en', slug: post.id },
				props: { ...post, data: { ...post.data, isTranslation: true } },
			});
		} else if (post.data.lang === 'en') {
			paths.push({
				params: { lang: 'es', slug: post.id },
				props: { ...post, data: { ...post.data, isTranslation: true } },
			});
		}
	}

	return paths;
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data}>
	<Content />
	<Comments />
</BlogPost>

<style>
	.translation-disclaimer {
		color: var(--accent);
		font-size: 1.2em;
		margin: 0.5em 0 1em 0;
		font-style: italic;
		background-color: black;
	}
</style>
