---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Comments from '../../components/Comments.astro';
import Redirect from '../../components/Redirect.astro';
import BlogPost from '../../layouts/BlogPost.astro';
import { postUrl } from '../../utils/posts';

// Each post lives at its original language. The other language prefix used to serve an untranslated
// copy, so it now redirects to the original.
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.flatMap((post) => {
		const other = post.data.lang === 'es' ? 'en' : 'es';
		return [
			{ params: { lang: post.data.lang, slug: post.id }, props: { post, redirect: false } },
			{ params: { lang: other, slug: post.id }, props: { post, redirect: true } },
		];
	});
}

type Props = { post: CollectionEntry<'blog'>; redirect: boolean };

const { post, redirect } = Astro.props;
const { Content } = await render(post);
const translations = post.data.translationKey
	? (await getCollection('blog', (entry) => entry.data.translationKey === post.data.translationKey)).filter((entry) => entry.id !== post.id)
	: [];
---

{
	redirect ? (
		<Redirect to={postUrl(post)} />
	) : (
		<BlogPost post={post} translations={translations}>
			<Content />
			<Comments slot="after" term={post.data.title} />
		</BlogPost>
	)
}
