---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Comments from '../../components/Comments.astro';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const paths = [];
	const seen = new Set<string>();
	for (const post of posts) {
		for (const lang of [post.data.lang, post.data.lang === 'es' ? 'en' : 'es'] as const) {
			const key = `${lang}/${post.id}`;
			if (seen.has(key)) continue;
			seen.add(key);
			paths.push({
				params: { lang, slug: post.id },
				props: { post, isTranslation: lang !== post.data.lang },
			});
		}
	}
	return paths;
}

type Props = { post: CollectionEntry<'blog'>; isTranslation: boolean };

const { post, isTranslation } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} isTranslation={isTranslation}>
	<Content />
	<Comments slot="after" />
</BlogPost>
