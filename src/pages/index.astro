---
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_HEADLINE, SITE_SEO_TITLE, YOUTUBE_COURSES } from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts } from '../utils/posts';

const posts = (await getPosts()).slice(0, 12);
---

<Base title={SITE_SEO_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<h1>Juan G. Carmona</h1>
		<p class="headline">{SITE_HEADLINE}</p>
		<p>
			20+ years designing secure, scalable systems for aerospace and defence, rail and smart mobility, and motorsport,
			for Airbus (Cassidian), Alstom, Porsche Motorsport and Solera, and as founder and CTO of Logtrip. Today I'm a
			Software Development Engineer at <a href="https://www.plainconcepts.com/">Plain Concepts</a>, working as a
			Forward Deployed Engineer: AI-SDLC, training, audits, assessments and SRE.
		</p>
		<p>
			<strong>Building:</strong> Software Engineering 2.0, how our profession works when agents write much of the code.
			<a href="https://talks.jgcarmona.com/software-engineering-2_0/">The talk</a> explains the idea, and
			<a href="/projects/">PDaC, ProductShape, ArcShape and Lighthouse</a> are the tools I build for it.
		</p>
		<p>
			<strong>Sharing:</strong> since 2006, when I started <em>Sharing experience and Computer Science Knowledge</em>.
			Today: this blog, <a href="/talks/">talks</a>, <a href="/books/">books</a> and
			<a href={YOUTUBE_COURSES[0].url}>YouTube courses</a>.
		</p>
	</section>

	<h2>Latest writing</h2>
	<PostList posts={posts} />
	<p><a href="/blog/">All posts →</a> · <a href="/tags/">Topics</a> · <a href="/search/">Search</a></p>
</Base>
