---
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import { PROFILES, SITE_DESCRIPTION, SITE_SEO_TITLE, YOUTUBE_COURSES } from '../consts';
import { FLAGSHIP_PROJECTS } from '../data/projects';
import { APPEARANCES, SPEAKER_LINKS } from '../data/speaking';
import Base from '../layouts/Base.astro';
import { getPosts, postUrl } from '../utils/posts';
import { ecosystem } from '../utils/schema';
import portrait from '../assets/portrait.jpg';
import convex from '../assets/talks/convex-2026.jpg';
import solidGrasp from '../assets/image-11.png';
import ddd from '../assets/image-12-724x1024.png';
import mastering from '../assets/book_cover_1-11.jpg';

// Curated, not chronological: the articles that carry the current argument. The first one leads.
const SELECTED = [
	'product-definition-as-code',
	'what-devex-means-in-2026',
	'ai-tooling-lacks-foundational-standards',
	'i-tried-to-prove-pdac-wrong',
	'multi-agent-ai-repository-architecture',
];

// The path that leads to the current focus. Source: CV (see /about).
const PATH = [
	{ year: '2011', field: 'Aerospace and defence', detail: 'Systems architecture for Cassidian, the Airbus defence division' },
	{ year: '2014', field: 'Rail and smart mobility', detail: 'The Alstom Madrid Innovation Lab, where Mastria was born' },
	{ year: '2018', field: 'Founder', detail: 'Logtrip, as CEO and CTO' },
	{ year: '2022', field: 'Motorsport data', detail: 'Azure architecture for the Porsche Motorsport Data Platform' },
	{ year: '2025', field: 'AI-SDLC', detail: 'Bringing AI into the whole delivery lifecycle, not only the code' },
];

const posts = await getPosts();
const [lead, ...stories] = SELECTED.map((id) => posts.find((post) => post.id === id)).filter((post) => post !== undefined);

const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const tools = FLAGSHIP_PROJECTS.slice(0, 4);
const [recording, ...record] = [...APPEARANCES].sort((a, b) => Number(!!b.videoUrl) - Number(!!a.videoUrl));
const month = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', timeZone: 'UTC' });

const books = [
	{ title: 'SOLID y GRASP', cover: solidGrasp },
	{ title: 'Domain-Driven Design', cover: ddd },
	{ title: 'Mastering Software Development', cover: mastering },
];
---

<Base title={SITE_SEO_TITLE} description={SITE_DESCRIPTION} schema={ecosystem} wide>
	<section class="frame home-hero" aria-labelledby="name">
		<div class="hero-copy">
			<h1 id="name" class="name">Juan G. Carmona</h1>
			<p class="statement">AI did not create our engineering problems. <span>It exposed them.</span></p>
			<p class="intro">
				For twenty years I have built critical systems: aerospace and defence, rail and smart mobility, motorsport data
				and a company of my own. Today I work on what AI-assisted delivery needs underneath: a
				<a href={`/projects/#${slug('Product Definition as Code')}`}>product definition</a> agents can cite,
				<a href={`/projects/#${slug('ArcShape')}`}>architecture documentation</a> that stays true to the code, and an
				<a href={`/projects/#${slug('Lighthouse')}`}>engineering baseline</a> every repository can verify. I call it
				<a href="https://talks.jgcarmona.com/software-engineering-2_0/">Software Engineering 2.0</a>.
			</p>
			<div class="actions">
				<a class="lh-button" href="/blog/">Read the writing</a>
				<a class="arrow" href="/talks/">Speaking</a>
				<a class="arrow" href="/about/">About me</a>
			</div>
		</div>
		<figure class="photo">
			<Image src={portrait} alt="Juan G. Carmona" widths={[360, 560, 840]} sizes="(max-width: 56rem) 100vw, 420px" loading="eager" fetchpriority="high" />
			<figcaption>Writing since 2006 · On stage since 2012</figcaption>
		</figure>
	</section>

	<section class="frame path" aria-labelledby="path">
		<h2 id="path" class="eyebrow">The road here</h2>
		<ol>
			{
				PATH.map((step) => (
					<li>
						<span class="year">{step.year}</span>
						<strong>{step.field}</strong>
						<small>{step.detail}</small>
					</li>
				))
			}
		</ol>
	</section>

	<section class="frame writing" aria-labelledby="writing">
		<header class="section-head">
			<div>
				<p class="eyebrow">Writing</p>
				<h2 id="writing">The current argument</h2>
			</div>
			<p>
				{posts.length} articles in English and Spanish.{' '}
				<a class="arrow" href="/blog/">The full archive</a>
			</p>
		</header>
		{
			lead && (
				<a class="lead-story" href={postUrl(lead)} hreflang={lead.data.lang}>
					{lead.data.heroImage && <Image src={lead.data.heroImage} alt="" widths={[480, 760, 1040]} sizes="(max-width: 56rem) 100vw, 640px" loading="lazy" />}
					<div>
						<span class="meta"><FormattedDate date={lead.data.pubDate} /></span>
						<h3>{lead.data.title}</h3>
						<p>{lead.data.description}</p>
						<span class="arrow">Read the article</span>
					</div>
				</a>
			)
		}
		<ol class="stories">
			{
				stories.map((post) => (
					<li>
						<a href={postUrl(post)} hreflang={post.data.lang}>
							{post.data.heroImage && <Image src={post.data.heroImage} alt="" width={480} loading="lazy" />}
							<span class="meta">
								<FormattedDate date={post.data.pubDate} />
								{post.data.lang === 'es' && ' · ES'}
							</span>
							<h3>{post.data.title}</h3>
							<p>{post.data.description}</p>
						</a>
					</li>
				))
			}
		</ol>
	</section>

	<section class="speaking-band" aria-labelledby="speaking">
		<div class="frame">
			<div class="stage">
				{
					recording?.videoUrl && (
						<a class="stage-photo" href={recording.videoUrl}>
							<Image src={convex} alt={`Juan G. Carmona on stage at ${recording.event}`} widths={[480, 800, 1280]} sizes="(max-width: 56rem) 100vw, 700px" loading="lazy" />
							<span class="play">Watch the recording</span>
						</a>
					)
				}
				<div class="stage-copy">
					<p class="eyebrow">Speaking</p>
					<h2 id="speaking">On stage</h2>
					{
						recording && (
							<>
								<p class="talk-event">
									{recording.event} · {recording.venue ? `${recording.venue}, ` : ''}
									{recording.city}
								</p>
								<p class="talk-title">{recording.title}</p>
								{recording.summary && <p class="talk-summary">{recording.summary}</p>}
							</>
						)
					}
					<div class="actions">
						<a class="lh-button" href={PROFILES.SESSIONIZE}>Sessionize profile</a>
						<a class="arrow" href="/talks/">Talks and sessions</a>
					</div>
				</div>
			</div>
			<ol class="timeline">
				{
					record.map((talk) => (
						<li>
							<time datetime={talk.date}>{month(talk.date)}</time>
							<strong>{talk.eventUrl ? <a href={talk.eventUrl}>{talk.event}</a> : talk.event}</strong>
							<span>{talk.title ?? talk.city}</span>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="frame tools" aria-labelledby="projects">
		<header class="section-head">
			<div>
				<p class="eyebrow">Projects</p>
				<h2 id="projects">Open tools, each with its own job</h2>
			</div>
			<p><a class="arrow" href="/projects/">All projects</a></p>
		</header>
		<ol class="tool-index">
			{
				tools.map((project, i) => (
					<li id={`home-${slug(project.name)}`}>
						<span class="index">{String(i + 1).padStart(2, '0')}</span>
						<div class="tool-name">
							<h3>
								<a href={project.links[0].url}>{project.name}</a>
							</h3>
							<p>{project.tagline}</p>
						</div>
						<div class="tool-purpose">
							{project.problem && <p class="problem">{project.problem}</p>}
							<p>{project.description}</p>
						</div>
						<ul class="tool-links">
							{project.links.map((link) => (
								<li>
									<a href={link.url}>{link.label}</a>
								</li>
							))}
						</ul>
					</li>
				))
			}
		</ol>
	</section>

	<section class="frame publications" aria-labelledby="publications">
		<header class="section-head">
			<div>
				<p class="eyebrow">Publications</p>
				<h2 id="publications">Books, courses and decks</h2>
			</div>
			<p><a class="arrow" href="/books/">Books</a></p>
		</header>
		<div class="shelf-layout">
			<ul class="shelf">
				{
					books.map((book) => (
						<li>
							<a href="/books/">
								<Image src={book.cover} alt={`Cover of ${book.title}`} widths={[200, 320]} sizes="(max-width: 40rem) 30vw, 180px" loading="lazy" />
								<span>{book.title}</span>
							</a>
						</li>
					))
				}
			</ul>
			<div>
				<h3 class="eyebrow">Video courses</h3>
				<ol class="courses">
					{
						YOUTUBE_COURSES.map((course) => (
							<li>
								<a href={course.url}>{course.title}</a>
							</li>
						))
					}
				</ol>
				<p class="decks">
					Slide decks: <a href={SPEAKER_LINKS.TALKS_SITE}>talks.jgcarmona.com</a>
				</p>
			</div>
		</div>
	</section>
</Base>
