---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE_SEO_TITLE, SITE_DESCRIPTION, YOUTUBE_COURSES } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Get featured posts (featured: true) or fallback to most recent 6
const featuredPosts = allPosts
	.filter((post) => post.data.featured)
	.sort((a, b) => (a.data.featuredOrder || 999) - (b.data.featuredOrder || 999))
	.slice(0, 6);

const displayPosts = featuredPosts.length > 0 ? featuredPosts : allPosts.slice(0, 6);

// Get latest 5 posts
const latestPosts = allPosts.slice(0, 5);

// Get top 12 tags
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
	const tags = post.data.tags || [];
	tags.forEach((tag) => {
		tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
	});
});

const topTags = Array.from(tagCounts.entries())
	.sort((a, b) => b[1] - a[1])
	.slice(0, 12)
	.map((entry) => entry[0]);

// YouTube courses data
const youtubeCourses = [
	{
		title: 'DADS | Diseño, Arquitectura y Desarrollo de Software',
		description: 'Aprende los fundamentos de diseño y arquitectura de software con ejemplos prácticos y casos reales.',
		videoCount: 15,
		url: YOUTUBE_COURSES.DADS,
	},
	{
		title: 'Micro Guías de Patrones de Diseño',
		description: 'Guías rápidas y concisas sobre los patrones de diseño más importantes en desarrollo de software.',
		videoCount: 26,
		url: YOUTUBE_COURSES.PATTERNS,
	},
	{
		title: 'IA con Azure - De la Teoría a la Práctica | AI102',
		description: 'Curso completo de inteligencia artificial con Azure, desde conceptos básicos hasta implementación práctica.',
		videoCount: 22,
		url: YOUTUBE_COURSES.AI102,
	},
	{
		title: 'Angular y .NET, arquitectura y buenas prácticas',
		description: 'Aprende a construir aplicaciones full-stack modernas con Angular y .NET siguiendo las mejores prácticas.',
		videoCount: 38,
		url: YOUTUBE_COURSES.ANGULAR_DOTNET,
	},
];

// Add skip link for accessibility
const skipLink = {
	href: "#main-content",
	text: "Skip to main content"
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_SEO_TITLE} description={SITE_DESCRIPTION} />
		<!-- Structured Data for Website -->
		<script is:inline type="application/ld+json">
		{`{
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "Juan G. Carmona Blog",
			"url": "https://jgcarmona.com/",
			"description": "Software Architecture, AI, Cloud Computing, and DevOps blog by Juan G. Carmona",
			"publisher": {
				"@type": "Person",
				"name": "Juan G. Carmona",
				"url": "https://jgcarmona.com/about"
			}
		}`}
		</script>
	</head>
	<body>
		<a href="#main-content" class="skip-link sr-only sr-only-focusable" aria-label="Skip to main content">Skip to main content</a>
		<Header />
		<main id="main-content">
			<!-- Hero Section -->
			<section class="hero">
			<div class="hero-grid">
				<!-- Text Content (left on desktop, below on mobile) -->
				<div class="hero-text">
					<h1>Juan G. Carmona</h1>
					<p class="hero-bio">					
					  Software Architect at
						<a
							href="https://www.plainconcepts.com/"
							target="_blank"
							rel="noopener noreferrer"
						>
							Plain Concepts
						</a>.
						I design secure and scalable software systems and apply AI, cloud,
						and DevSecOps with engineering discipline.
					</p>
					<div class="hero-social">
						<a href="https://www.linkedin.com/in/juangcarmona" target="_blank" rel="noopener noreferrer" aria-label="Follow on LinkedIn">
							<svg class="social-icon" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
							</svg>
							<span class="social-label">LinkedIn</span>
						</a>
						<a href="https://youtube.com/@juangcarmona" target="_blank" rel="noopener noreferrer" aria-label="Follow on YouTube">
							<svg class="social-icon" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
							</svg>
							<span class="social-label">YouTube</span>
						</a>
						<a href="https://github.com/juangcarmona" target="_blank" rel="noopener noreferrer" aria-label="Follow on GitHub">
							<svg class="social-icon" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
							</svg>
							<span class="social-label">GitHub</span>
						</a>
					</div>
				</div>

				<!-- Profile Picture (right on desktop, above on mobile) -->
				<div class="hero-image">
					<div class="profile-wrapper">
						<img 
							src="https://avatars.githubusercontent.com/u/2834629?v=4" 
							alt="Juan G. Carmona" 
							class="profile-pic"
						/>
						<!-- Decorative ring -->
						<div class="profile-ring"></div>
				</div>
			</section>

			<!-- Featured Posts -->
			<section class="featured-posts">
				<h2>Featured Posts</h2>
				<div class="posts-grid">
					{displayPosts.map((post) => (
						<ArticleCard post={post} />
					))}
				</div>
				<div class="section-cta">
					<a href="/blog" class="cta-button">View all posts →</a>
				</div>
			</section>

			<!-- YouTube Courses -->
			<section class="youtube-courses">
				<h2>YouTube Courses</h2>
				<p class="section-description">Video courses on software development, architecture, and AI</p>
				<div class="courses-grid">
					{youtubeCourses.map((course) => (
						<article class="course-card">
							<a href={course.url} target="_blank" rel="noopener noreferrer">
								<h3>{course.title}</h3>
								<p class="course-description">{course.description}</p>
								<div class="course-meta">
									<span class="course-count">{course.videoCount} videos</span>
									<span class="course-link">Watch →</span>
								</div>
							</a>
						</article>
					))}
				</div>
				<div class="section-cta">
					<a href="https://youtube.com/@juangcarmona" target="_blank" rel="noopener noreferrer" class="cta-button">
						View YouTube Channel →
					</a>
				</div>
			</section>

			<!-- Topics -->
			<section class="topics">
				<h2>Topics</h2>
				<div class="topics-grid">
					{topTags.map((tag) => (
						<a href={`/tags/${tag}`} class="topic-chip" aria-label={`View posts tagged with ${tag}`}>
							{tag}
						</a>
					))}
				</div>
				<div class="section-cta">
					<a href="/tags" class="cta-button">View all tags →</a>
				</div>
			</section>

			<!-- Latest Posts -->
			<section class="latest-posts">
				<h2>Latest Posts</h2>
				<ul class="posts-list">
					{latestPosts.map((post) => (
						<li class="post-item">
							<a href={`/${post.data.lang}/${post.id}/`}>
								<div class="post-info">
									<h3>{post.data.title}</h3>
									<p class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
							</a>
						</li>
					))}
				</ul>
				<div class="section-cta">
					<a href="/blog" class="cta-button">View all posts →</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		top: -40px;
		left: 6px;
		background: var(--accent);
		color: white;
		padding: 8px 16px;
		text-decoration: none;
		z-index: 1000;
	}
	
	.skip-link:focus {
		top: 6px;
	}
</style>

<style>
	main {
		width: 1200px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 2em 1em;
	}

	section {
		margin-bottom: 5em;
	}

	section h2 {
		font-size: 2.5em;
		margin-bottom: 0.5em;
		text-align: center;
	}

	.section-description {
		text-align: center;
		color: rgb(var(--gray));
		font-size: 1.1em;
		margin-bottom: 2em;
	}

	.section-cta {
		text-align: center;
		margin-top: 2.5em;
	}

	.cta-button {
		display: inline-block;
		padding: 0.75em 2em;
		background-color: var(--accent);
		color: white;
		text-decoration: none;
		border-radius: 6px;
		font-weight: 600;
		transition: all 0.2s ease;
		border: none;
		cursor: pointer;
		font-size: 1rem;
	}

	.cta-button:hover {
		background-color: var(--accent-dark);
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(var(--accent-dark), 0.4);
	}

	/* Hero Section */
	.hero {
		min-height: 60vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 3rem 1rem;
		margin-bottom: 4em;
	}

	.hero-grid {
		max-width: 1200px;
		margin: 0 auto;
		width: 100%;
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		align-items: center;
	}

	@media (min-width: 768px) {
		.hero-grid {
			grid-template-columns: 1fr 1fr;
			gap: 3rem;
		}
	}

	@media (min-width: 1024px) {
		.hero-grid {
			gap: 4rem;
		}
	}

	/* Text Content */
	.hero-text {
		text-align: center;
		order: 2;
	}

	@media (min-width: 768px) {
		.hero-text {
			text-align: left;
			order: 1;
		}
	}

	.hero h1 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
		color: var(--accent);
		line-height: 1.2;
		animation: fade-up 0.6s ease-out;
	}

	@media (min-width: 768px) {
		.hero h1 {
			font-size: 3rem;
		}
	}

	@media (min-width: 1024px) {
		.hero h1 {
			font-size: 3.75rem;
		}
	}

	.hero-bio {
		font-size: 1.125rem;
		color: rgb(var(--gray-light));
		margin-bottom: 2rem;
		line-height: 1.7;
		animation: fade-up 0.6s ease-out 0.1s backwards;
	}

	@media (min-width: 768px) {
		.hero-bio {
			font-size: 1.25rem;
		}
	}

	/* Social Links */
	.hero-social {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		animation: fade-up 0.6s ease-out 0.2s backwards;
	}

	.hero-social a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		border-radius: 9999px;
		background-color: rgb(var(--gray-dark));
		color: rgb(var(--gray-light));
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.hero-social a:hover {
		transform: scale(1.05) translateY(-2px);
		background-color: var(--accent);
		color: white;
	}

	.hero-social a:focus {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.social-icon {
		width: 1.25rem;
		height: 1.25rem;
		flex-shrink: 0;
	}

	.social-label {
		font-size: 0.875rem;
		font-weight: 500;
	}

	/* Profile Picture */
	.hero-image {
		display: flex;
		justify-content: center;
		order: 1;
		margin-bottom: 2rem;
		animation: fade-up 0.6s ease-out;
	}

	@media (min-width: 768px) {
		.hero-image {
			order: 2;
			margin-bottom: 0;
		}
	}

	.profile-wrapper {
		position: relative;
	}

	.profile-pic {
		width: 12rem;
		height: 12rem;
		border-radius: 50%;
		object-fit: cover;
		border: 4px solid var(--accent);
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
		transition: transform 0.3s ease;
	}

	@media (min-width: 768px) {
		.profile-pic {
			width: 16rem;
			height: 16rem;
		}
	}

	@media (min-width: 1024px) {
		.profile-pic {
			width: 20rem;
			height: 20rem;
		}
	}

	.profile-pic:hover {
		transform: scale(1.05);
	}

	.profile-ring {
		position: absolute;
		inset: -0.5rem;
		border-radius: 50%;
		border: 2px solid rgba(var(--accent-rgb), 0.4);
		animation: pulse-slow 3s ease-in-out infinite;
	}

	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes pulse-slow {
		0%, 100% {
			opacity: 0.6;
			transform: scale(1);
		}
		50% {
			opacity: 0.3;
			transform: scale(1.05);
		}
	}

	/* Featured Articles */
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2em;
	}

	/* YouTube Courses */
	.courses-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5em;
	}

	.course-card {
		background-color: rgb(var(--gray-dark));
		border-radius: 12px;
		padding: 2em;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.course-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--box-shadow);
	}

	.course-card a {
		text-decoration: none;
		display: block;
	}

	.course-card h3 {
		color: rgb(var(--gray-light));
		margin: 0 0 1em 0;
		font-size: 1.2em;
		line-height: 1.3;
	}

	.course-description {
		color: rgb(var(--gray));
		line-height: 1.6;
		margin-bottom: 1.5em;
		font-size: 0.95em;
	}

	.course-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		color: var(--accent);
		font-size: 0.9em;
		font-weight: 600;
	}

	.course-link {
		transition: transform 0.2s ease;
		display: inline-block;
	}

	.course-card:hover .course-link {
		transform: translateX(4px);
	}

	/* Topics */
	.topics-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1em;
		max-width: 900px;
		margin: 0 auto;
	}

	.topic-chip {
		display: inline-block;
		padding: 0.75em 1.5em;
		background-color: rgb(var(--gray-dark));
		border-radius: 50px;
		color: rgb(var(--gray-light));
		text-decoration: none;
		font-size: 0.95em;
		transition: all 0.2s ease;
	}

	.topic-chip:hover {
		background-color: var(--accent);
		color: white;
		transform: translateY(-2px);
	}

	/* Latest Posts */
	.posts-list {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: 800px;
		margin: 0 auto;
	}

	.post-item {
		border-bottom: 1px solid rgba(var(--gray), 0.2);
	}

	.post-item:last-child {
		border-bottom: none;
	}

	.post-item a {
		display: block;
		padding: 1.5em 0;
		text-decoration: none;
		transition: transform 0.2s ease;
	}

	.post-item a:hover {
		transform: translateX(8px);
	}

	.post-info h3 {
		color: rgb(var(--gray-light));
		margin: 0 0 0.5em 0;
		font-size: 1.2em;
		transition: color 0.2s ease;
	}

	.post-item a:hover .post-info h3 {
		color: var(--accent);
	}

	.post-date {
		color: rgb(var(--gray));
		font-size: 0.9em;
		margin: 0;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2.5em;
		}

		.hero-tagline {
			font-size: 1.1em;
		}

		.posts-grid,
		.courses-grid {
			grid-template-columns: 1fr;
		}

		section h2 {
			font-size: 2em;
		}
	}
</style>
