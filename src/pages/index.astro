---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION, YOUTUBE_COURSES } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Get featured posts (featured: true) or fallback to most recent 6
const featuredPosts = allPosts
	.filter((post) => post.data.featured)
	.sort((a, b) => (a.data.featuredOrder || 999) - (b.data.featuredOrder || 999))
	.slice(0, 6);

const displayPosts = featuredPosts.length > 0 ? featuredPosts : allPosts.slice(0, 6);

// Get latest 5 posts
const latestPosts = allPosts.slice(0, 5);

// Get top 12 tags
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
	const tags = post.data.tags || [];
	tags.forEach((tag) => {
		tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
	});
});

const topTags = Array.from(tagCounts.entries())
	.sort((a, b) => b[1] - a[1])
	.slice(0, 12)
	.map((entry) => entry[0]);

// YouTube courses data
const youtubeCourses = [
	{
		title: 'DADS | Diseño, Arquitectura y Desarrollo de Software',
		description: 'Aprende los fundamentos de diseño y arquitectura de software con ejemplos prácticos y casos reales.',
		videoCount: 15,
		url: YOUTUBE_COURSES.DADS,
	},
	{
		title: 'Micro Guías de Patrones de Diseño',
		description: 'Guías rápidas y concisas sobre los patrones de diseño más importantes en desarrollo de software.',
		videoCount: 26,
		url: YOUTUBE_COURSES.PATTERNS,
	},
	{
		title: 'IA con Azure - De la Teoría a la Práctica | AI102',
		description: 'Curso completo de inteligencia artificial con Azure, desde conceptos básicos hasta implementación práctica.',
		videoCount: 22,
		url: YOUTUBE_COURSES.AI102,
	},
	{
		title: 'Angular y .NET, arquitectura y buenas prácticas',
		description: 'Aprende a construir aplicaciones full-stack modernas con Angular y .NET siguiendo las mejores prácticas.',
		videoCount: 38,
		url: YOUTUBE_COURSES.ANGULAR_DOTNET,
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero">
				<div class="hero-content">
					<div class="hero-text">
						<h1>Juan G. Carmona</h1>
						<p class="hero-tagline">Software & AI Architect • Secure Systems • Cloud & DevOps</p>
						<ul class="hero-bullets">
							<li>Building secure, scalable platforms and agentic AI systems</li>
							<li>Leading full-stack solutions with strong DevSecOps</li>
							<li>Privacy-first AI: LLM orchestration, RAG pipelines, tool integrations</li>
						</ul>
						<div class="hero-social">
							<a href="https://www.linkedin.com/in/juangcarmona" target="_blank" aria-label="LinkedIn">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
									<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
								</svg>
							</a>
							<a href="https://youtube.com/@juangcarmona" target="_blank" aria-label="YouTube">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
									<path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"></path>
								</svg>
							</a>
							<a href="https://github.com/juangcarmona" target="_blank" aria-label="GitHub">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
									<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
								</svg>
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Featured Articles -->
			<section class="featured-articles">
				<h2>Featured Articles</h2>
				<div class="articles-grid">
					{displayPosts.map((post) => (
						<article class="article-card">
							<a href={`/${post.id}/`}>
								{post.data.heroImage && (
									<div class="article-image">
										<Image
											src={post.data.heroImage}
											alt={post.data.title}
											width={400}
											height={225}
										/>
									</div>
								)}
								<div class="article-content">
									<h3>{post.data.title}</h3>
									<p class="article-date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="article-description">{post.data.description}</p>
									{post.data.tags && post.data.tags.length > 0 && (
										<div class="article-tags">
											{post.data.tags.slice(0, 3).map((tag) => (
												<span class="article-tag">{tag}</span>
											))}
										</div>
									)}
								</div>
							</a>
						</article>
					))}
				</div>
				<div class="section-cta">
					<a href="/blog" class="cta-button">View all articles →</a>
				</div>
			</section>

			<!-- YouTube Courses -->
			<section class="youtube-courses">
				<h2>YouTube Courses</h2>
				<p class="section-description">Video courses on software development, architecture, and AI</p>
				<div class="courses-grid">
					{youtubeCourses.map((course) => (
						<article class="course-card">
							<a href={course.url} target="_blank" rel="noopener noreferrer">
								<h3>{course.title}</h3>
								<p class="course-description">{course.description}</p>
								<div class="course-meta">
									<span class="course-count">{course.videoCount} videos</span>
									<span class="course-link">Watch →</span>
								</div>
							</a>
						</article>
					))}
				</div>
				<div class="section-cta">
					<a href="https://youtube.com/@juangcarmona" target="_blank" rel="noopener noreferrer" class="cta-button">
						View YouTube Channel →
					</a>
				</div>
			</section>

			<!-- Topics -->
			<section class="topics">
				<h2>Topics</h2>
				<div class="topics-grid">
					{topTags.map((tag) => (
						<a href={`/tags/${tag}`} class="topic-chip">
							{tag}
						</a>
					))}
				</div>
				<div class="section-cta">
					<a href="/tags" class="cta-button">View all tags →</a>
				</div>
			</section>

			<!-- Latest Posts -->
			<section class="latest-posts">
				<h2>Latest Posts</h2>
				<ul class="posts-list">
					{latestPosts.map((post) => (
						<li class="post-item">
							<a href={`/${post.id}/`}>
								<div class="post-info">
									<h3>{post.data.title}</h3>
									<p class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
							</a>
						</li>
					))}
				</ul>
				<div class="section-cta">
					<a href="/blog" class="cta-button">View all posts →</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 1200px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 2em 1em;
	}

	section {
		margin-bottom: 5em;
	}

	section h2 {
		font-size: 2.5em;
		margin-bottom: 0.5em;
		text-align: center;
	}

	.section-description {
		text-align: center;
		color: rgb(var(--gray));
		font-size: 1.1em;
		margin-bottom: 2em;
	}

	.section-cta {
		text-align: center;
		margin-top: 2.5em;
	}

	.cta-button {
		display: inline-block;
		padding: 0.75em 2em;
		background-color: var(--accent);
		color: white;
		text-decoration: none;
		border-radius: 6px;
		font-weight: 600;
		transition: all 0.2s ease;
	}

	.cta-button:hover {
		background-color: var(--accent-dark);
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(var(--accent-dark), 0.4);
	}

	/* Hero Section */
	.hero {
		padding: 4em 0;
		margin-bottom: 4em;
	}

	.hero-content {
		max-width: 900px;
		margin: 0 auto;
	}

	.hero h1 {
		font-size: 3.5em;
		margin-bottom: 0.25em;
		text-align: center;
	}

	.hero-tagline {
		font-size: 1.3em;
		color: var(--accent);
		text-align: center;
		margin-bottom: 2em;
	}

	.hero-bullets {
		list-style: none;
		padding: 0;
		margin: 0 0 2em 0;
		font-size: 1.1em;
		line-height: 1.8;
	}

	.hero-bullets li {
		padding-left: 1.5em;
		position: relative;
		margin-bottom: 0.75em;
		color: rgb(var(--gray-light));
	}

	.hero-bullets li::before {
		content: "▸";
		position: absolute;
		left: 0;
		color: var(--accent);
	}

	.hero-social {
		display: flex;
		justify-content: center;
		gap: 1.5em;
	}

	.hero-social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background-color: rgba(var(--gray-dark), 0.5);
		color: rgb(var(--gray-light));
		transition: all 0.2s ease;
	}

	.hero-social a:hover {
		background-color: var(--accent);
		color: white;
		transform: translateY(-2px);
	}

	/* Featured Articles */
	.articles-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2em;
	}

	.article-card {
		background-color: rgb(var(--gray-dark));
		border-radius: 12px;
		overflow: hidden;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.article-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--box-shadow);
	}

	.article-card a {
		text-decoration: none;
		display: block;
	}

	.article-image {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.article-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.article-card:hover .article-image img {
		transform: scale(1.05);
	}

	.article-content {
		padding: 1.5em;
	}

	.article-content h3 {
		color: rgb(var(--gray-light));
		margin: 0 0 0.5em 0;
		font-size: 1.3em;
		line-height: 1.3;
	}

	.article-date {
		color: rgb(var(--gray));
		font-size: 0.85em;
		margin-bottom: 0.75em;
	}

	.article-description {
		color: rgb(var(--gray-light));
		line-height: 1.5;
		margin-bottom: 1em;
		font-size: 0.95em;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}

	.article-tag {
		padding: 0.25em 0.75em;
		background-color: rgba(var(--gray), 0.2);
		border-radius: 4px;
		font-size: 0.8em;
		color: rgb(var(--gray));
	}

	/* YouTube Courses */
	.courses-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5em;
	}

	.course-card {
		background-color: rgb(var(--gray-dark));
		border-radius: 12px;
		padding: 2em;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.course-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--box-shadow);
	}

	.course-card a {
		text-decoration: none;
		display: block;
	}

	.course-card h3 {
		color: rgb(var(--gray-light));
		margin: 0 0 1em 0;
		font-size: 1.2em;
		line-height: 1.3;
	}

	.course-description {
		color: rgb(var(--gray));
		line-height: 1.6;
		margin-bottom: 1.5em;
		font-size: 0.95em;
	}

	.course-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		color: var(--accent);
		font-size: 0.9em;
		font-weight: 600;
	}

	.course-link {
		transition: transform 0.2s ease;
		display: inline-block;
	}

	.course-card:hover .course-link {
		transform: translateX(4px);
	}

	/* Topics */
	.topics-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1em;
		max-width: 900px;
		margin: 0 auto;
	}

	.topic-chip {
		display: inline-block;
		padding: 0.75em 1.5em;
		background-color: rgb(var(--gray-dark));
		border-radius: 50px;
		color: rgb(var(--gray-light));
		text-decoration: none;
		font-size: 0.95em;
		transition: all 0.2s ease;
	}

	.topic-chip:hover {
		background-color: var(--accent);
		color: white;
		transform: translateY(-2px);
	}

	/* Latest Posts */
	.posts-list {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: 800px;
		margin: 0 auto;
	}

	.post-item {
		border-bottom: 1px solid rgba(var(--gray), 0.2);
	}

	.post-item:last-child {
		border-bottom: none;
	}

	.post-item a {
		display: block;
		padding: 1.5em 0;
		text-decoration: none;
		transition: transform 0.2s ease;
	}

	.post-item a:hover {
		transform: translateX(8px);
	}

	.post-info h3 {
		color: rgb(var(--gray-light));
		margin: 0 0 0.5em 0;
		font-size: 1.2em;
		transition: color 0.2s ease;
	}

	.post-item a:hover .post-info h3 {
		color: var(--accent);
	}

	.post-date {
		color: rgb(var(--gray));
		font-size: 0.9em;
		margin: 0;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2.5em;
		}

		.hero-tagline {
			font-size: 1.1em;
		}

		.articles-grid,
		.courses-grid {
			grid-template-columns: 1fr;
		}

		section h2 {
			font-size: 2em;
		}
	}
</style>
