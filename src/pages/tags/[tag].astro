---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, type Post } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const tags = new Set(posts.flatMap((post) => post.data.tags));
	return [...tags].map((tag) => ({
		params: { tag },
		props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}

type Props = { tag: string; posts: Post[] };

const { tag, posts } = Astro.props;
---

<Base title={`${tag} — Juan G. Carmona`} description={`Articles about ${tag} by Juan G. Carmona.`}>
	<p class="eyebrow"><a href="/tags/">Topics</a></p>
	<h1>{tag}</h1>
	<p class="muted">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
	<PostList posts={posts} showDescription />
</Base>
