---
import { getCollection } from 'astro:content';
import Redirect from '../components/Redirect.astro';
import { postUrl } from '../utils/posts';

// The WordPress-era URLs (/slug/) keep working as redirects to the canonical post URL.
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { slug: post.id }, props: { to: postUrl(post) } }));
}
---

<Redirect to={Astro.props.to} />
