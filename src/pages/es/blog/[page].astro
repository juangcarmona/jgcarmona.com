---
import BlogIndex from '../../../components/BlogIndex.astro';
import { getBlogPages } from '../../../utils/posts';
export async function getStaticPaths() {
  return (await getBlogPages()).slice(1).map((page) => ({ params: { page: String(page.page) }, props: page }));
}
const page = Astro.props;
---
<BlogIndex {...page} lang="es" />
