---
import BlogPage from "../../components/BlogPage.astro";
import { getCollection } from "astro:content";

const pageSize = 10;
const featuredBonus = 1;
const effectivePageSize = pageSize + featuredBonus;

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Page 1 shows (pageSize + 1) items for featured post
const posts = allPosts.slice(0, effectivePageSize);

// Calculate total pages consistently with [page].astro
const remainingAfterFirst = allPosts.length - effectivePageSize;
const extraPages = Math.max(0, Math.ceil(remainingAfterFirst / pageSize));
const totalPages = 1 + extraPages;

const paginationItems = [];
const currentPage = 1;
for (let p = 1; p <= totalPages; p++) {
  const near = Math.abs(p - currentPage) <= 1;
  const edge = p === 1 || p === totalPages;

  if (near || edge) paginationItems.push(p);
  else paginationItems.push(null);
}

const compact: (number | "ellipsis")[] = [];
for (let i = 0; i < paginationItems.length; i++) {
  const item = paginationItems[i];
  if (item === null) {
    if (compact[compact.length - 1] !== "ellipsis") {
      compact.push("ellipsis");
    }
  } else {
    compact.push(item);
  }
}
---

<BlogPage posts={posts} page={1} totalPages={totalPages} compact={compact} />
