---
import { PROFILES } from '../consts';
import { APPEARANCES, SESSIONS, SPEAKER_LINKS } from '../data/speaking';
import Base from '../layouts/Base.astro';

const title = 'Talks — Juan G. Carmona';
const description =
	'Conference talks by Juan G. Carmona at CONVEX, GitHub Copilot Dev Days Madrid and RootedCON, and the sessions he offers to organisers.';
const month = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', timeZone: 'UTC' });

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': APPEARANCES.map((talk) => ({
		'@type': 'Event',
		name: talk.title ? `${talk.title} — ${talk.event}` : talk.event,
		startDate: talk.date,
		...(talk.endDate && { endDate: talk.endDate }),
		eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
		eventStatus: 'https://schema.org/EventScheduled',
		...(talk.summary && { description: talk.summary }),
		location: {
			'@type': 'Place',
			name: talk.venue ?? talk.city,
			address: { '@type': 'PostalAddress', addressLocality: talk.city, addressCountry: talk.country ?? 'ES' },
		},
		performer: { '@id': new URL('/#person', Astro.site).href },
		...(talk.eventUrl && { url: talk.eventUrl }),
		...(talk.videoUrl && { recordedIn: { '@type': 'VideoObject', name: talk.title, embedUrl: talk.videoUrl } }),
	})),
};
---

<Base title={title} description={description}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<h1>Talks</h1>
	<p>
		I speak about what AI is changing in software engineering and about the security of the people who build software.
		Organisers can find every session on <a href={SPEAKER_LINKS.SESSIONIZE}>Sessionize</a>; decks live at
		<a href={SPEAKER_LINKS.TALKS_SITE}>talks.jgcarmona.com</a>.
	</p>
	<p><a class="lh-button" href={PROFILES.SESSIONIZE}>Invite me to your event</a></p>

	<h2>Where I have spoken</h2>
	<ol class="entries">
		{
			APPEARANCES.map((talk) => (
				<li class="lh-card">
					<p class="eyebrow">
						{talk.eventUrl ? <a href={talk.eventUrl}>{talk.event}</a> : talk.event}
					</p>
					{talk.title && <h3>{talk.title}</h3>}
					<p class="muted mono">
						<time datetime={talk.date}>{month(talk.date)}</time> · {talk.venue ? `${talk.venue}, ${talk.city}` : talk.city}
					</p>
					{talk.summary && <p>{talk.summary}</p>}
					<ul class="inline-list">
						{talk.videoUrl && <li><a href={talk.videoUrl}>Video</a></li>}
						{talk.slidesUrl && <li><a href={talk.slidesUrl}>Slides</a></li>}
						{talk.relatedPost && <li><a href={talk.relatedPost}>Related post</a></li>}
						{talk.sourceUrl && <li><a href={talk.sourceUrl}>Source</a></li>}
					</ul>
				</li>
			))
		}
	</ol>

	<h2>Sessions I offer</h2>
	<ul class="entries">
		{
			SESSIONS.map((session) => (
				<li>
					<h3>{session.url ? <a href={session.url}>{session.title}</a> : session.title}</h3>
					<p class="muted">{session.summary}</p>
					{session.lang && <span class="lh-badge">{session.lang}</span>}
				</li>
			))
		}
	</ul>
</Base>
