---
import { FLAGSHIP_PROJECTS, OTHER_PROJECTS } from '../data/projects';
import Base from '../layouts/Base.astro';

const title = 'Projects — Juan G. Carmona';
const description =
	'Open-source projects by Juan G. Carmona: Product Definition as Code, ProductShape, ArcShape and Lighthouse, a toolchain for AI-assisted delivery, DomusMind, Raccord and more.';
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const personId = new URL('/#person', Astro.site).href;

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [...FLAGSHIP_PROJECTS, ...OTHER_PROJECTS].map((project) => {
		const links = 'links' in project ? project.links : [{ label: 'GitHub', url: project.url }];
		return {
			'@type': 'SoftwareSourceCode',
			name: project.name,
			description: 'tagline' in project ? project.tagline : project.description,
			url: links[0].url,
			codeRepository: links.find((link) => link.url.startsWith('https://github.com/'))?.url,
			author: { '@id': personId },
		};
	}),
};
---

<Base title={title} description={description}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<h1>Projects</h1>
	<p>
		AI makes code cheap. What stays expensive is knowing what to build, keeping the architecture honest and proving that
		what shipped is what was agreed. These projects work together on that, from the product definition to delivery.
	</p>
	<ol class="inline-list">
		{FLAGSHIP_PROJECTS.map((project) => <li><a href={`#${slug(project.name)}`}>{project.name}</a></li>)}
	</ol>

	{
		FLAGSHIP_PROJECTS.map((project) => (
			<section id={slug(project.name)}>
				<p class="eyebrow">{project.role}</p>
				<h2>{project.name}</h2>
				<p><strong>{project.tagline}</strong></p>
				<p>{project.description}</p>
				<ul class="inline-list">
					{project.stack.map((item) => <li class="lh-badge">{item}</li>)}
				</ul>
				<p class="inline-list">
					{project.links.map((link) => <a href={link.url}>{link.label}</a>)}
				</p>
				{project.relatedPosts && (
					<ul>
						{project.relatedPosts.map((post) => (
							<li>
								<a href={post.url}>{post.label}</a>
							</li>
						))}
					</ul>
				)}
			</section>
		))
	}

	<h2>More open source</h2>
	<ul class="entries">
		{
			OTHER_PROJECTS.map((project) => (
				<li>
					<h3><a href={project.url}>{project.name}</a></h3>
					<p class="muted">{project.description}</p>
				</li>
			))
		}
	</ul>
	<p>Everything else is on <a href="https://github.com/juangcarmona">GitHub</a>.</p>
</Base>
