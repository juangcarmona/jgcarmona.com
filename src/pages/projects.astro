---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { FLAGSHIP_PROJECTS, OTHER_PROJECTS } from '../data/projects';

const title = 'Projects — Juan G. Carmona: PDaC, ProductShape, ArcShape, Lighthouse, DomusMind';
const description =
	'Open-source projects by Juan G. Carmona: Product Definition as Code, ProductShape, ArcShape and Lighthouse, a toolchain for AI-assisted software delivery, and DomusMind, a product built with it.';

const pageUrl = new URL('/projects/', Astro.site).href;
const personId = new URL('/#person', Astro.site).href;

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	'@id': pageUrl,
	url: pageUrl,
	name: title,
	description,
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: FLAGSHIP_PROJECTS.map((project, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			item: {
				'@type': 'SoftwareSourceCode',
				name: project.name,
				description: project.tagline,
				url: project.links[0].url,
				codeRepository: project.links.find((link) => link.url.includes('github.com'))?.url,
				author: { '@type': 'Person', '@id': personId, name: 'Juan G. Carmona' },
			},
		})),
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Projects</h1>
				<p class="lead">
					AI makes code cheap. What stays expensive is knowing what to build, keeping the architecture
					honest and proving that what shipped is what was agreed. These projects are my answer to that, and
					they are built to work together.
				</p>
				<ol class="chain" aria-label="How the projects fit together">
					{FLAGSHIP_PROJECTS.map((project) => (
						<li>
							<a href={`#${project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
								<span class="chain-name">{project.name}</span>
								<span class="chain-role">{project.role}</span>
							</a>
						</li>
					))}
				</ol>
			</section>

			<section class="flagships" aria-label="Main projects">
				{FLAGSHIP_PROJECTS.map((project, index) => (
					<article class="project" id={project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
						<p class="project-role">
							<span class="project-number">{String(index + 1).padStart(2, '0')}</span>
							{project.role}
						</p>
						<h2>{project.name}</h2>
						<p class="project-tagline">{project.tagline}</p>
						<p>{project.description}</p>
						<ul class="stack" aria-label={`${project.name} technologies`}>
							{project.stack.map((item) => <li>{item}</li>)}
						</ul>
						<ul class="project-links">
							{project.links.map((link) => (
								<li>
									<a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
								</li>
							))}
						</ul>
						{project.relatedPosts && (
							<div class="related">
								<p>Read more</p>
								<ul>
									{project.relatedPosts.map((post) => (
										<li>
											<a href={post.url}>{post.label}</a>
										</li>
									))}
								</ul>
							</div>
						)}
					</article>
				))}
			</section>

			<section aria-labelledby="other-projects">
				<h2 id="other-projects">More open source</h2>
				<div class="other-grid">
					{OTHER_PROJECTS.map((project) => (
						<a class="other-card" href={project.url} target="_blank" rel="noopener noreferrer">
							<h3>{project.name}</h3>
							<p>{project.description}</p>
						</a>
					))}
				</div>
				<p class="more">
					Everything else is on <a href="https://github.com/juangcarmona" target="_blank" rel="noopener noreferrer">GitHub</a>.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 2em 1em;
	}

	section {
		margin-bottom: 4em;
	}

	h1 {
		color: var(--accent);
		margin-bottom: 0.5em;
	}

	.lead {
		font-size: 1.2em;
		line-height: 1.7;
		color: rgb(var(--gray-light));
	}

	.chain {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: 0.75em;
		list-style: none;
		padding: 0;
		margin: 2em 0 0;
	}

	.chain li {
		display: flex;
	}

	.chain a {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.25em;
		padding: 1em;
		border-radius: 10px;
		border: 1px solid rgba(var(--accent-rgb), 0.4);
		text-decoration: none;
		transition: background-color 0.2s ease;
	}

	.chain a:hover {
		background-color: rgba(var(--accent-rgb), 0.12);
	}

	.chain-name {
		font-weight: 700;
		color: rgb(var(--gray-light));
	}

	.chain-role {
		font-size: 0.85em;
		color: rgb(var(--gray));
	}

	.project {
		padding: 2em 0;
		border-top: 1px solid rgba(var(--gray), 0.3);
		scroll-margin-top: 4em;
	}

	.project-role {
		display: flex;
		align-items: center;
		gap: 0.75em;
		margin: 0;
		font-size: 0.85em;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--accent);
	}

	.project-number {
		color: rgb(var(--gray));
	}

	.project h2 {
		margin: 0.25em 0;
		font-size: 2em;
	}

	.project-tagline {
		font-size: 1.15em;
		font-weight: 600;
		color: rgb(var(--gray-light));
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		list-style: none;
		padding: 0;
		margin: 1em 0;
	}

	.stack li {
		padding: 0.25em 0.75em;
		border-radius: 999px;
		background-color: rgb(var(--gray-dark));
		font-size: 0.85em;
		color: rgb(var(--gray-light));
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25em;
		list-style: none;
		padding: 0;
		margin: 0;
		font-weight: 600;
	}

	.related {
		margin-top: 1.25em;
		font-size: 0.95em;
	}

	.related p {
		margin: 0 0 0.25em;
		color: rgb(var(--gray));
	}

	.related ul {
		margin: 0;
		padding-left: 1.25em;
	}

	.other-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25em;
	}

	.other-card {
		display: block;
		padding: 1.25em;
		border-radius: 12px;
		background-color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: transform 0.2s ease;
	}

	.other-card:hover {
		transform: translateY(-3px);
	}

	.other-card h3 {
		margin: 0 0 0.5em;
		font-size: 1.05em;
		color: rgb(var(--gray-light));
	}

	.other-card p {
		margin: 0;
		font-size: 0.9em;
		color: rgb(var(--gray));
	}

	.more {
		margin-top: 1.5em;
	}
</style>
