---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { postUrl } from '../utils/posts';

interface Props {
	posts: CollectionEntry<'blog'>[];
	showDescription?: boolean;
}

const { posts, showDescription = false } = Astro.props;
---

<ol class="post-list">
	{
		posts.map((post) => (
			<li>
				<FormattedDate date={post.data.pubDate} class="mono" />
				<div>
					<a href={postUrl(post)} hreflang={post.data.lang}>{post.data.title}</a>
					{post.data.lang === 'es' && <span class="lh-badge" title="Written in Spanish">ES</span>}
				</div>
				{showDescription && <p>{post.data.description}</p>}
			</li>
		))
	}
</ol>
