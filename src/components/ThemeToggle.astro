<div class="theme-switch" role="group" aria-label="Appearance">
	<button type="button" data-theme-option="light" aria-label="Light" aria-pressed="false">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
			><circle cx="12" cy="12" r="4"></circle><path
				d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg
		>
	</button>
	<button type="button" data-theme-option="dark" aria-label="Dark" aria-pressed="false">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
			><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg
		>
	</button>
	<button type="button" data-theme-option="system" aria-label="System" aria-pressed="false">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
			><rect x="3" y="4" width="18" height="12"></rect><path d="M8 20h8M12 16v4"></path></svg
		>
	</button>
</div>

<script>
	type Preference = 'system' | 'light' | 'dark';
	const root = document.documentElement;
	const media = matchMedia('(prefers-color-scheme: dark)');
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]');

	function apply(preference: Preference) {
		const dark = preference === 'dark' || (preference === 'system' && media.matches);
		root.setAttribute('data-lh-theme', preference);
		root.setAttribute('data-theme', dark ? 'dark' : 'light');
		buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeOption === preference)));
		window.dispatchEvent(new CustomEvent('theme:changed', { detail: { theme: dark ? 'dark' : 'light' } }));
	}

	const current = () => (root.getAttribute('data-lh-theme') as Preference) || 'system';

	buttons.forEach((button) =>
		button.addEventListener('click', () => {
			const next = button.dataset.themeOption as Preference;
			try {
				localStorage.setItem('lh-theme', next);
			} catch {}
			apply(next);
		}),
	);
	media.addEventListener('change', () => current() === 'system' && apply('system'));
	apply(current());
</script>
