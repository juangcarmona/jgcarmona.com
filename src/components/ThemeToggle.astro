<button type="button" class="lh-button theme-toggle" data-variant="secondary" id="theme-toggle" aria-label="Change appearance">
	<span id="theme-label">System</span>
</button>

<script>
	const ORDER = ['system', 'light', 'dark'] as const;
	type Preference = (typeof ORDER)[number];
	const LABELS: Record<Preference, string> = { system: 'System', light: 'Light', dark: 'Dark' };
	const root = document.documentElement;
	const media = matchMedia('(prefers-color-scheme: dark)');

	function apply(preference: Preference) {
		const dark = preference === 'dark' || (preference === 'system' && media.matches);
		root.setAttribute('data-lh-theme', preference);
		root.setAttribute('data-theme', dark ? 'dark' : 'light');
		const label = document.getElementById('theme-label');
		if (label) label.textContent = LABELS[preference];
		document.getElementById('theme-toggle')?.setAttribute('aria-label', `Appearance: ${LABELS[preference]}. Change appearance`);
		window.dispatchEvent(new CustomEvent('theme:changed', { detail: { theme: dark ? 'dark' : 'light' } }));
	}

	const current = () => (root.getAttribute('data-lh-theme') as Preference) || 'system';

	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
		try {
			localStorage.setItem('lh-theme', next);
		} catch {}
		apply(next);
	});
	media.addEventListener('change', () => current() === 'system' && apply('system'));
	apply(current());
</script>
