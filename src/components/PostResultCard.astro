---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	highlightTag?: string;
}

const { post, highlightTag } = Astro.props;
---

<article class="post-result-card">
	<a href={`/${post.data.lang}/${post.id}/`} aria-label={`Read article: ${post.data.title}`}>
		<div class="post-thumb">
			{post.data.heroImage ? (
				<Image
					src={post.data.heroImage}
					alt={post.data.title || "Article image"}
					width={80}
					height={80}
					loading="lazy"
				/>
			) : (
				<span class="thumb-placeholder">📄</span>
			)}
		</div>
		<div class="post-info">
			<h3 class="post-title">{post.data.title}</h3>
			<p class="post-summary">{post.data.description}</p>
			<div class="post-footer">
				<time class="post-date">
					<FormattedDate date={post.data.pubDate} />
				</time>
				{post.data.tags && post.data.tags.length > 0 && (
					<div class="post-tags">
						{post.data.tags.map((tag) => (
							<a href={`/tags/${tag}`} class:list={{ 'post-tag': true, 'active': highlightTag && tag === highlightTag }}>
								{tag}
							</a>
						))}
					</div>
				)}
			</div>
		</div>
	</a>
</article>

<style>
	.post-result-card {
		background-color: rgb(var(--gray-dark));
		border-radius: 8px;
		overflow: hidden;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.post-result-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--box-shadow);
	}

	.post-result-card a {
		text-decoration: none;
		display: flex;
		gap: 1em;
		padding: 1em;
	}

	.post-thumb {
		flex-shrink: 0;
		width: 80px;
		height: 80px;
		border-radius: 6px;
		overflow: hidden;
		background-color: rgba(var(--gray), 0.1);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.post-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.thumb-placeholder {
		font-size: 1.8em;
		opacity: 0.5;
	}

	.post-info {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3em;
	}

	.post-title {
		color: rgb(var(--gray-light));
		margin: 0;
		font-size: 1.05em;
		line-height: 1.3;
		transition: color 0.2s ease;
	}

	.post-result-card a:hover .post-title {
		color: var(--accent);
	}

	.post-summary {
		color: rgb(var(--gray));
		line-height: 1.5;
		margin: 0;
		font-size: 0.85em;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-footer {
		display: flex;
		align-items: center;
		gap: 0.75em;
		flex-wrap: wrap;
		margin-top: auto;
	}

	.post-date {
		color: rgb(var(--gray));
		font-size: 0.8em;
		flex-shrink: 0;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}

	.post-tag {
		padding: 0.15em 0.6em;
		background-color: rgba(var(--gray), 0.15);
		border-radius: 3px;
		font-size: 0.75em;
		color: rgb(var(--gray));
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.post-tag:hover {
		color: var(--accent);
		background-color: rgba(var(--accent-rgb), 0.15);
	}

	.post-tag.active {
		background-color: var(--accent);
		color: white;
	}

	@media (max-width: 600px) {
		.post-result-card a {
			flex-direction: column;
		}

		.post-thumb {
			width: 100%;
			height: 120px;
		}
	}
</style>
