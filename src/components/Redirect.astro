---
// A static permanent redirect: Static Web Apps cannot hold one rule per post (20 KB config limit),
// and search engines treat an immediate meta refresh as a permanent redirect.
interface Props {
	to: string;
}

const target = new URL(Astro.props.to, Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Moved</title>
		<meta name="robots" content="noindex, follow" />
		<link rel="canonical" href={target} />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
	</head>
	<body>
		<p>This page moved to <a href={target}>{target}</a>.</p>
	</body>
</html>
