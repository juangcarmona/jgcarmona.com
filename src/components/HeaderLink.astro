---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

// pathname relativo al BASE_URL
const base = import.meta.env.BASE_URL ?? "/";
let pathname = Astro.url.pathname.replace(base, "");

// normaliza: siempre con "/" delante
if (!pathname.startsWith("/")) {
  pathname = "/" + pathname;
}
if (pathname === "") {
  pathname = "/";
}

// primer segmento (/blog/lo-que-sea → "blog")
const subpath = pathname.match(/[^\/]+/g);
const firstSegment = subpath?.[0] || "";

// activo si:
// 1) coincide exactamente
// 2) coincide por primer segmento (pero no confundir / con /blog)
const isActive =
  href === pathname ||
  (href !== "/" && href === "/" + firstSegment);
---

<a href={href} class:list={[className, { active: isActive }]} {...props} aria-current={isActive ? "page" : undefined}>
  <slot />
</a>

<style>
  a {
    display: inline-block;
    text-decoration: none;
  }
  a.active {
    font-weight: bolder;
    text-decoration: underline;
  }
</style>
