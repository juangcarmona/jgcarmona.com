---
// TagGraph.astro — D3.js force-directed tag graph
// Node click navigates to /tags/{tag}
---

<div class="tag-graph-wrapper">
<svg id="tag-graph" aria-label="Tag co-occurrence graph" role="img"></svg>
</div>

<script client:load>
(async function() {
const d3Module = await import('https://cdn.jsdelivr.net/npm/d3@7/+esm');
const { forceSimulation, forceLink, forceManyBody, forceCenter, forceCollide, select, drag } = d3Module;

const PALETTE = [
'#1971c2', '#c92a2a', '#2f9e44', '#e67700',
'#7048e8', '#c2255c', '#0c8599', '#5c940d',
'#862e9c', '#1098ad', '#d6336c', '#364fc7',
'#f76707', '#2b8a3e',
];
const CHAR_W = 7;
const PAD_X = 12;
const NODE_H = 28;
const MIN_W = 64;

function nodeWidth(label) {
return Math.max(MIN_W, label.length * CHAR_W + PAD_X * 2);
}

async function initGraph() {
const svgEl = document.getElementById('tag-graph');
if (!svgEl) return;

const width = svgEl.clientWidth || 900;
const height = svgEl.clientHeight || 450;

let data;
try {
const res = await fetch('/tags-data.json');
if (!res.ok) return;
data = await res.json();
} catch (e) { console.error('[TagGraph] Failed to load tags data:', e); return; }
if (!data.nodes.length) return;

const sortedIds = [...data.nodes].sort((a, b) => a.id.localeCompare(b.id)).map(n => n.id);
const colorMap = new Map(sortedIds.map((id, i) => [id, PALETTE[i % PALETTE.length]]));

const nodes = data.nodes.map(n => ({ ...n, w: nodeWidth(n.id), color: colorMap.get(n.id) }));
const links = data.links.map(l => ({ ...l }));

const svgSel = select(svgEl).attr('width', width).attr('height', height);
const g = svgSel.append('g');

const simulation = forceSimulation(nodes)
.force('link', forceLink(links).id(d => d.id).distance(130).strength(0.35))
.force('charge', forceManyBody().strength(-500))
.force('center', forceCenter(width / 2, height / 2))
.force('collide', forceCollide().radius(d => d.w / 2 + 8));

const linkSel = g.append('g').attr('class', 'graph-links').selectAll('line').data(links).join('line');

const nodeGroup = g.append('g').attr('class', 'graph-nodes')
.selectAll('g').data(nodes).join('g')
.attr('cursor', 'pointer')
.call(drag()
.on('start', (ev, d) => { if (!ev.active) simulation.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; })
.on('drag',  (ev, d) => { d.fx = ev.x; d.fy = ev.y; })
.on('end',   (ev, d) => { if (!ev.active) simulation.alphaTarget(0); d.fx = null; d.fy = null; })
)
.on('click', (ev, d) => {
ev.stopPropagation();
window.location.href = `/tags/${encodeURIComponent(d.id)}`;
});

nodeGroup.append('rect').attr('class', 'graph-node')
.attr('width', d => d.w)
.attr('height', NODE_H)
.attr('x', d => -d.w / 2)
.attr('y', -NODE_H / 2)
.attr('rx', 4)
.style('fill', d => d.color);

nodeGroup.append('text').attr('class', 'graph-label').text(d => d.id);
nodeGroup.append('title').text(d => `${d.id} — ${d.count} posts`);

simulation.on('tick', () => {
nodes.forEach(d => {
const hw = d.w / 2, hh = NODE_H / 2;
d.x = Math.max(hw + 2, Math.min(width - hw - 2, d.x ?? width / 2));
d.y = Math.max(hh + 2, Math.min(height - hh - 2, d.y ?? height / 2));
});
linkSel.attr('x1', d => d.source.x).attr('y1', d => d.source.y)
       .attr('x2', d => d.target.x).attr('y2', d => d.target.y);
nodeGroup.attr('transform', d => `translate(${d.x},${d.y})`);
});
}

if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', initGraph);
} else {
initGraph();
}
})();
</script>

<style>
.tag-graph-wrapper { margin-bottom: 0; }

#tag-graph {
width: 100%;
height: clamp(300px, 45vh, 500px);
border-radius: 4px;
border: 1px solid rgba(var(--gray), 0.2);
background: var(--bg-color);
display: block;
}

:global(.graph-links line) {
stroke: rgb(var(--gray));
stroke-opacity: 0.4;
stroke-width: 1;
}

:global(.graph-node) {
stroke: none;
}

:global(.graph-label) {
fill: #fff;
font-size: 11px;
font-weight: 600;
text-anchor: middle;
dominant-baseline: central;
pointer-events: none;
user-select: none;
}
</style>
