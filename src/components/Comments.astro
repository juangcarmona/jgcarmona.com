---
// Comments live in GitHub Discussions through giscus. The third-party frame loads only when the reader asks for it,
// so the page itself sets no cookies.
interface Props {
	/** Discussion term; the post title, matching what giscus mapped before. */
	term: string;
}

const { term } = Astro.props;
---

<section class="comments" aria-labelledby="comments-title">
	<h2 id="comments-title">Comments</h2>
	<p class="muted">
		Comments are stored in GitHub Discussions and shown through giscus. Loading them contacts giscus.app and GitHub,
		which may set their own cookies.
	</p>
	<button type="button" class="lh-button" data-variant="secondary" id="load-comments" data-term={term}>Show comments</button>
	<div id="giscus"></div>
</section>

<script>
	const button = document.getElementById('load-comments') as HTMLButtonElement | null;
	const theme = () => (document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark_protanopia');

	button?.addEventListener('click', () => {
		const script = document.createElement('script');
		const attributes: Record<string, string> = {
			src: 'https://giscus.app/client.js',
			crossorigin: 'anonymous',
			'data-repo': 'juangcarmona/jgcarmona.com',
			'data-repo-id': 'R_kgDOQfZC7w',
			'data-category': 'General',
			'data-category-id': 'DIC_kwDOQfZC784CzNMT',
			'data-mapping': 'specific',
			'data-term': button.dataset.term ?? document.title,
			'data-strict': '0',
			'data-reactions-enabled': '1',
			'data-emit-metadata': '0',
			'data-input-position': 'bottom',
			'data-lang': 'en',
			'data-theme': theme(),
		};
		for (const [name, value] of Object.entries(attributes)) script.setAttribute(name, value);
		script.async = true;
		document.getElementById('giscus')?.appendChild(script);
		button.remove();
	});

	window.addEventListener('theme:changed', () => {
		const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
		frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app');
	});
</script>
