---
import { PROFILES, SITE_TITLE } from '../consts';

const profiles = [
	{ name: 'LinkedIn', url: PROFILES.LINKEDIN },
	{ name: 'GitHub', url: PROFILES.GITHUB },
	{ name: 'YouTube', url: PROFILES.YOUTUBE },
	{ name: 'Sessionize', url: PROFILES.SESSIONIZE },
];
---

<footer class="site-footer">
	<div>
		<ul class="inline-list" aria-label="Profiles">
			{profiles.map((profile) => <li><a href={profile.url} rel="me">{profile.name}</a></li>)}
			<li><a href="/rss.xml">RSS</a></li>
			<li><a href="/privacy/">Privacy · no cookies</a></li>
		</ul>
		<p>© {new Date().getFullYear()} {SITE_TITLE} · Content licensed under CC BY 4.0</p>
	</div>
</footer>
