---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"blog">[];
  page: number;
  totalPages: number;
  compact: (number | "ellipsis")[];
}

const { posts, page, totalPages, compact } = Astro.props as Props;

import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <style>
      main {
        width: 960px;
        margin-top: 2em;
      }

      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      /* ===== ITEMS ===== */

      ul li {
        width: calc(50% - 1rem);
      }

      ul li.card-item {
        width: calc(50% - 1rem);
      }

      ul li * {
        text-decoration: none;
        transition: 0.2s ease;
      }

      /* ===== FEATURED ===== */

      ul li.featured {
        width: 100%;
        margin-bottom: 2rem;
        text-align: left;
      }

      ul li.featured .thumb {
        max-height: 360px;
      }

      ul li.featured .title {
        font-size: 1.9rem;
        line-height: 1.15;
        margin: 0.75rem 0 0.25rem;
      }

      /* ===== REGULAR ITEMS ===== */

      ul li .title {
        font-size: 1.15rem;
        line-height: 1.25;
        margin: 0.5rem 0 0.25rem;
      }

      /* ===== TEXT ===== */

      .title {
        color: rgb(var(--gray-light));
      }

      .date {
        margin: 0;
        color: rgb(var(--gray));
        font-size: 0.85rem;
      }

      .excerpt {
        margin-top: 0.5rem;
        color: rgb(var(--gray-light));
        font-size: 0.95rem;
        line-height: 1.5;
        max-width: 720px;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5em;
        margin-top: 0.5rem;
      }

      .tag {
        display: inline-block;
        padding: 0.25em 0.75em;
        background-color: rgba(var(--gray-dark), 0.5);
        border-radius: 4px;
        font-size: 0.75em;
        color: rgb(var(--gray));
        text-decoration: none;
        transition: all 0.2s ease;
      }

      .tag:hover {
        background-color: var(--accent);
        color: white;
      }

      /* ===== THUMB ===== */

      .thumb {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 12px;
      }

      .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* ===== HOVER ===== */

      ul li a:hover .title,
      ul li a:hover .date {
        color: var(--accent);
      }

      ul li a:hover .thumb {
        box-shadow: var(--box-shadow);
      }

      /* ===== MOBILE ===== */

      @media (max-width: 720px) {
        ul li,
        ul li.card-item {
          width: 100%;
        }
      }

      /* ===== PAGINATION ===== */

      .pagination {
        margin-top: 2rem;
        display: flex;
        justify-content: center;
        gap: 1rem;
      }

      .pagination a {
        color: rgb(var(--gray-light));
        text-decoration: none;
      }

      .pagination strong {
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section>
        <ul>
          {
            posts.map((post, i) => {
              const isFeatured = page === 1 && i === 0;

              if (isFeatured) {
                return (
                  <li class="featured">
                    <a href={`/${post.data.lang}/${post.id}/`}>
                      {post.data.heroImage && (
                        <div class="thumb">
                          <Image
                            width={720}
                            height={360}
                            src={post.data.heroImage}
                            alt={post.data.title || "Article image"}
                            loading="lazy"
                          />
                        </div>
                      )}

                      <h4 class="title">{post.data.title}</h4>

                      <p class="date">
                        <FormattedDate date={post.data.pubDate} />
                      </p>
                    </a>

                    {post.data.description && (
                      <p class="excerpt">{post.data.description}</p>
                    )}

                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="tags">
                        {post.data.tags.slice(0, 3).map((tag) => (
                          <a href={`/tags/${tag}`} class="tag">
                            {tag}
                          </a>
                        ))}
                      </div>
                    )}
                  </li>
                );
              }

              // Use ArticleCard for non-featured posts
              return (
                <li class="card-item">
                  <ArticleCard post={post} />
                </li>
              );
            })
          }
        </ul>

        <nav class="pagination">
          {page > 1 && <a href={`/blog/1`}>« First</a>}
          {page > 1 && <a href={`/blog/${page - 1}`}>‹ Prev</a>}

          {
            compact.map((item) => {
              if (item === "ellipsis") {
                return <span>…</span>;
              }
              if (item === page) {
                return <strong>{item}</strong>;
              }
              return <a href={`/blog/${item}`}>{item}</a>;
            })
          }

          {page < totalPages && <a href={`/blog/${page + 1}`}>Next ›</a>}
          {page < totalPages && <a href={`/blog/${totalPages}`}>Last »</a>}
        </nav>
      </section>
    </main>
    <Footer />
  </body>
</html>
