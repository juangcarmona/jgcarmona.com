---
import '@juangcarmona/lighthouse-ui';
import '../styles/site.css';
import { SITE_TITLE } from '../consts';
import { graph } from '../utils/schema';
import themeInit from '../scripts/theme-init.js?raw';

interface Props {
	title: string;
	description: string;
	/** Absolute or root-relative URL of the social image. */
	image?: string;
	imageAlt?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	lang?: 'en' | 'es';
	noindex?: boolean;
	/** Extra schema.org nodes; the Person and WebSite nodes are always included. */
	schema?: object[];
}

const {
	title,
	description,
	image = '/og-default.png',
	imageAlt = `${SITE_TITLE}: Software Architect · AI Strategist · Critical & Secure Systems`,
	type = 'website',
	publishedTime,
	modifiedTime,
	tags = [],
	lang = 'en',
	noindex = false,
	schema = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Search results cut titles around 60 characters: long article titles drop the site name rather than lose their own words.
const suffix = ` — ${SITE_TITLE}`;
const pageTitle = title.length > 65 && title.endsWith(suffix) ? title.slice(0, -suffix.length) : title;
const imageURL = new URL(image, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="author" content={SITE_TITLE} />
<meta name="generator" content={Astro.generator} />

{/* Inlined so the stored appearance applies before first paint without a render-blocking request. */}
<script is:inline set:html={themeInit} />
<meta name="color-scheme" content="light dark" />

<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />

<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={graph(...schema)} />

<slot />

<!-- Cookieless analytics: GoatCounter stores nothing on the device. -->
<script is:inline data-goatcounter="https://jgcarmona-com.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
