---
// Simple search bar component
import { useState } from 'react';

interface Props {
  placeholder?: string;
}

const { placeholder = "Search blog posts..." } = Astro.props;
---

<div class="search-container">
  <form action="/search" method="GET" class="search-form">
    <input 
      type="search" 
      name="q" 
      placeholder={placeholder}
      class="search-input"
      autocomplete="off"
    />
    <button type="submit" class="search-button">🔍</button>
  </form>
</div>

<style>
.search-container {
  margin: 2em 0;
  text-align: center;
}

.search-form {
  display: flex;
  justify-content: center;
  gap: 0.5em;
  max-width: 500px;
  margin: 0 auto;
}

.search-input {
  flex: 1;
  padding: 0.75em 1em;
  border: 1px solid rgba(var(--gray), 0.3);
  border-radius: 4px;
  background-color: rgb(var(--gray-dark));
  color: rgb(var(--gray-light));
  font-size: 1rem;
}

.search-input:focus {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.search-button {
  padding: 0.75em 1.5em;
  background-color: var(--accent);
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-weight: 600;
  transition: background-color 0.2s ease;
}

.search-button:hover {
  background-color: var(--accent-dark);
}
</style>