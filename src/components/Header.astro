---
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const links = [
	{ href: '/blog/', label: 'Writing', match: ['blog', 'tags', 'search', 'en', 'es'] },
	{ href: '/talks/', label: 'Speaking', match: ['talks'] },
	{ href: '/projects/', label: 'Projects', match: ['projects'] },
	{ href: '/books/', label: 'Publications', match: ['books'] },
	{ href: '/about/', label: 'About', match: ['about'] },
];
const section = Astro.url.pathname.split('/')[1] ?? '';
---

<header class="site-header">
	<div class="frame">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
			<span>Menu</span>
		</button>
		<nav class="site-nav" id="site-nav" aria-label="Main">
			{
				links.map(({ href, label, match }) => (
					<a href={href} aria-current={match.includes(section) ? 'page' : undefined}>
						{label}
					</a>
				))
			}
		</nav>
		<ThemeToggle />
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') !== 'true';
		toggle.setAttribute('aria-expanded', String(open));
		toggle.closest('.site-header')?.toggleAttribute('data-open', open);
	});
</script>
