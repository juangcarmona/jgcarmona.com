---
import Monogram from './Monogram.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
	{ href: '/blog/', label: 'Blog' },
	{ href: '/talks/', label: 'Talks' },
	{ href: '/projects/', label: 'Projects' },
	{ href: '/about/', label: 'About' },
];
const section = '/' + (Astro.url.pathname.split('/')[1] ?? '') + '/';
const isBlogPost = /^\/(en|es)\//.test(Astro.url.pathname);
---

<header class="site-header">
	<nav aria-label="Main">
		<a class="brand" href="/" aria-label="Juan G. Carmona, home"><Monogram /></a>
		{
			links.map(({ href, label }) => (
				<a href={href} aria-current={href === section || (isBlogPost && href === '/blog/') ? 'page' : undefined}>
					{label}
				</a>
			))
		}
		<ThemeToggle />
	</nav>
</header>
