---
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const links = [
	{ href: '/blog/', label: 'Writing', match: ['blog', 'tags', 'search', 'en', 'es'] },
	{ href: '/talks/', label: 'Speaking', match: ['talks', 'courses'] },
	{ href: '/projects/', label: 'Projects', match: ['projects'] },
	{ href: '/books/', label: 'Publications', match: ['books'] },
	{ href: '/about/', label: 'About', match: ['about'] },
];
const pathname = Astro.url.pathname;
const isSpanishPage = pathname === '/es/' || /^\/es\/(about|projects|talks|courses|books|blog|search|tags)(\/|$)/.test(pathname);
const section = pathname.split('/')[isSpanishPage ? 2 : 1] ?? '';
const spanish = isSpanishPage;
const translated = spanish ? pathname.replace(/^\/es(?=\/)/, '') || '/' : (/^\/(blog\/\d+|tags\/[^/]+)\/$/.test(pathname) ? `/es${pathname}` : ({ '/': '/es/', '/about/': '/es/about/', '/projects/': '/es/projects/', '/talks/': '/es/talks/', '/courses/': '/es/courses/', '/books/': '/es/books/', '/blog/': '/es/blog/', '/search/': '/es/search/', '/tags/': '/es/tags/' } as Record<string, string>)[pathname]);
const labels: Record<string, string> = { Writing: 'Artículos', Speaking: 'Charlas', Projects: 'Proyectos', Publications: 'Publicaciones', About: 'Sobre mí' };
---

<header class="site-header">
	<div class="frame">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
			<span>{spanish ? 'Menú' : 'Menu'}</span>
		</button>
		<nav class="site-nav" id="site-nav" aria-label="Main">
			{
				links.map(({ href, label, match }) => (
					<a href={href} aria-current={match.includes(section) ? 'page' : undefined}>
						{spanish ? labels[label] : label}
					</a>
				))
			}
		</nav>
		<div class="language-switch" aria-label="Language / Idioma">
			<a href={spanish && translated ? translated : pathname} lang="en" data-language="en" aria-current={!spanish ? 'true' : undefined}>EN</a>
			<a href={!spanish && translated ? translated : pathname} lang="es" data-language="es" aria-current={spanish ? 'true' : undefined}>ES</a>
		</div>
		<ThemeToggle />
	</div>
</header>

<script>
	const links = document.querySelectorAll<HTMLAnchorElement>('[data-language]');
	for (const link of links) link.addEventListener('click', () => {
		try { localStorage.setItem('site-language', link.dataset.language!); } catch { /* Storage is optional. */ }
	});
	const language = (() => { try { return localStorage.getItem('site-language'); } catch { return null; } })();
	const path = location.pathname;
	const spanishPage = path === '/es/' || /^\/es\/(about|projects|talks|courses|books|blog|search|tags)(\/|$)/.test(path);
	const sharedPage = !spanishPage && !['/', '/about/', '/projects/', '/talks/', '/courses/', '/books/', '/blog/'].includes(path);
	if (sharedPage && language === 'es') {
		const translations: Record<string, string> = { Writing: 'Artículos', Speaking: 'Charlas', Projects: 'Proyectos', Publications: 'Publicaciones', About: 'Sobre mí' };
		document.querySelectorAll<HTMLAnchorElement>('.site-nav a').forEach(link => { link.textContent = translations[link.textContent!.trim()] || link.textContent; });
		links.forEach(link => link.toggleAttribute('aria-current', link.dataset.language === 'es'));
	}
	if (language === 'es' || spanishPage) {
		const routes: Record<string, string> = { '/': '/es/', '/about/': '/es/about/', '/projects/': '/es/projects/', '/talks/': '/es/talks/', '/courses/': '/es/courses/', '/books/': '/es/books/', '/blog/': '/es/blog/', '/search/': '/es/search/', '/tags/': '/es/tags/' };
		for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href]')) {
			if (link.hasAttribute('data-language')) continue;
			const target = new URL(link.href);
			if (target.origin === location.origin && routes[target.pathname]) link.href = routes[target.pathname] + target.search + target.hash;
			else if (target.origin === location.origin && /^\/tags\/[^/]+\/$/.test(target.pathname)) link.href = '/es' + target.pathname + target.search + target.hash;
		}
	}
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') !== 'true';
		toggle.setAttribute('aria-expanded', String(open));
		toggle.closest('.site-header')?.toggleAttribute('data-open', open);
	});
</script>
