---
import Base from './Base.astro';

// Markdown pages pass their frontmatter as props.
const { title, description, lang = 'en' } = Astro.props.frontmatter ?? Astro.props;
---

<Base title={`${title} — Juan G. Carmona`} description={description} lang={lang}>
	<div class="prose">
		<h1>{title}</h1>
		<slot />
	</div>
</Base>
