---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { postUrl } from '../utils/posts';
import { PERSON_ID, WEBSITE_ID } from '../utils/schema';
import Base from './Base.astro';
import portrait from '../assets/portrait.jpg';

type Props = {
	post: CollectionEntry<'blog'>;
	translations?: CollectionEntry<'blog'>[];
};

const { post, translations = [] } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, lang } = post.data;
const url = new URL(postUrl(post), Astro.site).href;
const socialImage = heroImage ? (await getImage({ src: heroImage, width: 1200, format: 'jpg' })).src : undefined;
const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const versions = [post, ...translations];

const article = {
	'@type': 'BlogPosting',
	'@id': `${url}#article`,
	mainEntityOfPage: url,
	url,
	headline: title,
	description,
	inLanguage: lang,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@id': PERSON_ID },
	publisher: { '@id': PERSON_ID },
	isPartOf: { '@id': WEBSITE_ID },
	image: new URL(socialImage ?? '/og-default.png', Astro.site).href,
	wordCount,
	keywords: tags,
	...(translations.length > 0 && { workTranslation: translations.map((entry) => ({ '@id': `${new URL(postUrl(entry), Astro.site).href}#article` })) }),
};
---

<Base
	title={`${title} — Juan G. Carmona`}
	description={description}
	image={socialImage}
	imageAlt={title}
	type="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate}
	tags={tags}
	lang={lang}
	schema={[article]}
>
	<Fragment slot="head">
		{
			translations.length > 0 &&
				versions.map((entry) => <link rel="alternate" hreflang={entry.data.lang} href={new URL(postUrl(entry), Astro.site)} />)
		}
	</Fragment>
	<article>
		<header class="article-header">
			<p class="eyebrow"><a href="/blog/">Blog</a>{lang === 'es' && <span lang="es"> · En español</span>}</p>
			<h1>{title}</h1>
			<p class="byline">
				<Image class="avatar" src={portrait} alt="" width={64} />
				<span>
					<strong>Juan G. Carmona</strong>
					<span class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && <> · updated <FormattedDate date={updatedDate} /></>}
						{
							translations.map((entry) => (
								<>
									{' · '}
									<a href={postUrl(entry)} hreflang={entry.data.lang} lang={entry.data.lang}>
										{entry.data.lang === 'es' ? 'Leer en español' : 'Read in English'}
									</a>
								</>
							))
						}
					</span>
				</span>
			</p>
			{heroImage && <Image class="hero" src={heroImage} alt="" width={1360} loading="eager" fetchpriority="high" />}
		</header>
		<div class="prose">
			<slot />
		</div>
		{
			tags.length > 0 && (
				<ul class="tag-list" aria-label="Tags">
					{tags.map((tag) => (
						<li>
							<a href={`/tags/${tag}/`}>{tag}</a>
						</li>
					))}
				</ul>
			)
		}
		<slot name="after" />
	</article>
</Base>
