---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import Base from './Base.astro';

type Props = {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	tags?: string[];
	lang?: 'en' | 'es';
	isTranslation?: boolean;
};

const { title, description, pubDate, updatedDate, heroImage, tags = [], lang = 'en', isTranslation } = Astro.props;
const socialImage = heroImage ? (await getImage({ src: heroImage, width: 1200, format: 'jpg' })).src : undefined;
---

<Base
	title={`${title} — Juan G. Carmona`}
	description={description}
	image={socialImage}
	imageAlt={title}
	type="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate}
	tags={tags}
	lang={lang}
>
	<slot name="head" slot="head" />
	<article>
		<header class="article-header">
			{heroImage && <Image class="hero" src={heroImage} alt="" width={1360} loading="eager" fetchpriority="high" />}
			<h1>{title}</h1>
			<p class="muted mono">
				<FormattedDate date={pubDate} />
				{updatedDate && <> · updated <FormattedDate date={updatedDate} /></>}
			</p>
			{isTranslation && <p class="lh-alert" data-tone="caution">This page shows the original text without translation.</p>}
		</header>
		<div class="prose">
			<slot />
		</div>
		{
			tags.length > 0 && (
				<ul class="inline-list tag-list" aria-label="Tags">
					{tags.map((tag) => (
						<li>
							<a class="lh-badge" href={`/tags/${tag}/`}>{tag}</a>
						</li>
					))}
				</ul>
			)
		}
		<slot name="after" />
	</article>
</Base>
