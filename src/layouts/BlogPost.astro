---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: calc(100%);
				max-width: 100%;
			}
			.hero-image {
				width: 100vw;
				margin-left: calc(50% - 50vw);
				margin-right: calc(50% - 50vw);
				max-height: 280px;
				overflow: hidden;
			}

			.hero-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				border-radius: 0;
			}

			.prose {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-light));
			}

			/* Center images in markdown posts */
			.prose :global(p:has(> img)) {
				text-align: center;
			}

			.prose :global(img) {
				display: inline-block;
				margin: 0 auto;
			}

			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin-bottom: 0.25em;
			}

			.date {
				margin-bottom: 1em;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}

			.last-updated-on {
				font-style: italic;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-top: 1.5em;
				padding-top: 1.5em;
				border-top: 1px solid rgba(var(--gray), 0.2);
			}

			.tag {
				display: inline-block;
				padding: 0.4em 1em;
				background-color: rgba(var(--gray-dark), 0.5);
				border-radius: 4px;
				font-size: 0.9em;
				color: rgb(var(--gray-light));
				text-decoration: none;
				transition: all 0.2s ease;
			}

			.tag:hover {
				background-color: var(--accent);
				color: white;
				transform: translateY(-2px);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image
								width={1600}
								height={400}
								src={heroImage}
								alt=""
								priority
							/>
						</div>
					)
				}
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>

						<hr />
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on{" "}
										<FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
					</div>

					<slot />

					{tags && tags.length > 0 && (
						<div class="tags">
							{tags.map((tag) => (
								<a href={`/tags/${tag}`} class="tag">
									{tag}
								</a>
							))}
						</div>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
