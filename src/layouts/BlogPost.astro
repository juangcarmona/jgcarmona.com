---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	tags?: string[];
	isTranslation?: boolean;
	lang?: 'en' | 'es';
};

const { title, description, pubDate, updatedDate, heroImage, tags, isTranslation, lang } = Astro.props;
---

<html lang={lang}>
	<head>
		<BaseHead 
			title={title} 
			description={description} 
			image={heroImage} 
			article={true}
			publishedTime={pubDate ? pubDate.toISOString() : undefined}
			modifiedTime={updatedDate ? updatedDate.toISOString() : undefined}
			author="Juan G. Carmona"
			tags={tags}
		/>
		<!-- Enhanced Structured Data for Blog Posts -->
		<script is:inline type="application/ld+json">
		{`{
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": "${new URL(Astro.url.href).href}"
			},
			"headline": "${title}",
			"description": "${description}",
			"image": "${heroImage ? heroImage : 'https://jgcarmona.com/images/og-default.png'}",
			"author": {
				"@type": "Person",
				"name": "Juan G. Carmona",
				"url": "https://jgcarmona.com/about"
			},
			"publisher": {
				"@type": "Organization",
				"name": "Juan G. Carmona",
				"logo": {
					"@type": "ImageObject",
					"url": "https://jgcarmona.com/images/logo.png",
					"width": 1200,
					"height": 630
				}
			},
			"datePublished": "${pubDate ? pubDate.toISOString() : new Date().toISOString()}",
			"dateModified": "${updatedDate ? updatedDate.toISOString() : pubDate ? pubDate.toISOString() : new Date().toISOString()}",
			"articleBody": "${description.substring(0, 200)}...",
			"wordCount": 1500,
			"estimatedReadingTime": "8 mins"
		}`}
		</script>
		<style>
			main {
				width: calc(100%);
				max-width: 100%;
			}
			.hero-image {
				width: 100%;
				max-width: 100%;
				margin-left: auto;
				margin-right: auto;
				max-height: 280px;
				overflow: hidden;
				position: relative;
				display: flex;
				align-items: center;
				justify-content: center;
				max-width: 900px; /* Prevent overly wide images on large screens */
			}

			.hero-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				border-radius: 0;
				min-height: 100px; /* Ensure minimum visibility */
				flex-shrink: 0;
			}

			.prose {
				width: 900px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-light));
			}

			/* Center images in markdown posts */
			.prose :global(p:has(> img)) {
				text-align: center;
			}

			.prose :global(img) {
				display: inline-block;
				margin: 0 auto;
			}

			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin-bottom: 0.25em;
			}

			.date {
				margin-bottom: 1em;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}

			.last-updated-on {
				font-style: italic;
			}

			.translation-disclaimer {
				color: var(--accent);
				font-size: 1.2em;
				margin: 0.5em 0 1em 0;
				font-style: italic;
				background-color: rgb(var(--gray-light));
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-top: 1.5em;
				padding-top: 1.5em;
				border-top: 1px solid rgba(var(--gray), 0.2);
			}

			.tag {
				display: inline-block;
				padding: 0.4em 1em;
				background-color: rgba(var(--gray-dark), 0.5);
				border-radius: 4px;
				font-size: 0.9em;
				color: rgb(var(--gray-light));
				text-decoration: none;
				transition: all 0.2s ease;
			}

			.tag:hover {
				background-color: var(--accent);
				color: white;
				transform: translateY(-2px);
			}
			
			/* Mermaid diagrams */
			.prose :global(.mermaid-diagram) {
				display: flex;
				justify-content: center;
				margin: 1.5em 0;
				overflow-x: auto;
			}

			.prose :global(.mermaid-diagram svg) {
				max-width: 100%;
				height: auto;
			}

			/* Reading progress indicator */
			.progress-container {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 4px;
				background-color: transparent;
				z-index: 1000;
			}
			
			.progress-bar {
				height: 100%;
				background-color: var(--accent);
				width: 0%;
				transition: width 0.1s ease;
			}
		</style>
	</head>

	<body>
		<div class="progress-container">
			<div class="progress-bar" id="progressBar"></div>
		</div>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image
								width={1600}
								height={400}
								src={heroImage}
								alt="Hero image for '${title}' - Illustration representing the key themes of the article: ${description.substring(0, 100)}..."
								loading="lazy"
							/>
						</div>
					)
				}
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>

						<hr />
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on{" "}
										<FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
					</div>

					{isTranslation && (
						<p class="translation-disclaimer">
							⚠️ Please note that this content has been translated using an automated tool. While I have reviewed the output, some nuances may have been lost.
						</p>
					)}

					<slot />

					{tags && tags.length > 0 && (
						<div class="tags">
							{tags.map((tag) => (
								<a href={`/tags/${tag}`} class="tag">
									{tag}
								</a>
							))}
						</div>
					)}
				</div>
			</article>
		</main>
		<Footer />
		
		<script>
			// Reading progress indicator
			document.addEventListener('DOMContentLoaded', () => {
				const progressBar = document.getElementById('progressBar');
				
				function updateProgress() {
					const scrollTop = window.scrollY;
					const docHeight = document.body.offsetHeight;
					const winHeight = window.innerHeight;
					const progress = (scrollTop / (docHeight - winHeight)) * 100;
					progressBar.style.width = `${Math.min(progress, 100)}%`;
				}
				
				window.addEventListener('scroll', updateProgress);
				updateProgress();
			});
		</script>
	</body>
</html>
